t":false,"ts_bd_i":false,"ts_va_i":false,"ts_fs":12.0,"ts_ff":"Times New Roman","ts_st":false,"ts_sc_i":false,"ts_fgc2_i":false,"ts_bd":false}},{"ty":"as","st":"text","si":3414,"ei":3415,"sm":{"ts_ff_i":false,"ts_fs":12.0,"ts_ff":"Times New Roman","ts_fgc2_i":false,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_fs_i":false}},{"ty":"as","st":"text","si":3416,"ei":3444,"sm":{"ts_un":false,"ts_un_i":false,"ts_sc":false,"ts_it_i":false,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_st_i":false,"ts_bgc2":{"hclr_color":null,"clr_type":0},"ts_fs_i":false,"ts_ff_i":false,"ts_bgc2_i":false,"ts_va":"nor","ts_it":false,"ts_bd_i":false,"ts_va_i":false,"ts_fs":12.0,"ts_ff":"Times New Roman","ts_st":false,"ts_sc_i":false,"ts_fgc2_i":false,"ts_bd":false}},{"ty":"as","st":"text","si":3445,"ei":4186,"sm":{"ts_ff_i":false,"ts_fs":12.0,"ts_ff":"Times New Roman","ts_fgc2_i":false,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_fs_i":false}},{"ty":"ord","ord":"s-blob-v1-ROUNDTRIP_DATA-lXAvhl_eanI"}]; DOCS_modelChunkLoadStart = new Date().getTime(); _getTimingInstance().incrementTime('mp', DOCS_modelChunkLoadStart - DOCS_modelChunkParseStart); DOCS_warmStartDocumentLoader.loadModelChunk(DOCS_modelChunk); DOCS_modelChunk = undefined;</script><script nonce="">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="">DOCS_modelChunk = [{"ty":"is","ibi":4187,"s":"\n\n\n\nCS-I-225 - Goddess Saraswati\n\n19th century bronze figure of Goddess Saraswati seated on a peacock from South India. Saraswati is the Hindu goddess of knowledge, learning, wisdom, music, art, speech, poetry, purification, language, and culture. She holds a veena in her front hands and budded lotuses in her back hands.  \nShe is associated with two vahanas - peacocks and swans. In southern India the vahana as peacock is more popular as depicted in this figure. Raja Ravi Varma who brought the first printed images of Hindu gods and goddesses to common household did associate and paint Saraswati with peacocks. Peacock is symbolic of colourful splendour and as the devourer of snakes, preaches the ability to transform poison into plumage of enlightenment. \nXLII-184 - Goddess Ganga \n\n18th century bronze sculpture of Goddess Ganga seated on a crocodile like figure known as Makara. Goddess Ganga is the personification of the river Ganges, highly revered by the Hindus as symbol of purification and forgiveness. She is the mother goddesses of all gods. \n\nThe four armed goddess holds a lotus in her back right hand and a ewer of water in her back left hand. Her front right hand forms the abhaya mudra and her front left hand forms the varada mudra. She is ornamented from head to toe with earrings, necklaces, armlets and anklets. \n\nXLII-233 - Nritya Ganesha\n13th century bronze figure of Lord Ganesha standing on a lotus pedestal from Vijayanagara era, Karnataka. This four armed figure holds parasu in his two right hands and in the left two hands hold the pasa and modaka. Ganpati is depicted with a broken teeth and he is ornamented head to toe with a crown, necklace, girdle, and anklets. \nAn nritya/dancing figure of Lord Ganesha is a unique and eclectic depiction in Hindu art and sculpture. In this figure, his body is slightly curved with his weight on the left leg and slightly bent over the right leg, adding a sense of grace and movement. \n\nACQ-65-13 - Shri Chakra\nA rare and unique folk art style representation of the Sri Chakra as a deity. Sri Chakra is an ancient Hindu symbol representing the union of masculine and feminine energies. It consists of nine layers each representing a different aspect of the universe and human consciousness. The Chakra is usually depicted in 2D form, however the Salar Jung Museum gallery showcases a creative personification of the Chakra in 3D form. When the object is viewed from an aerial direction, all the layers and the patterns are visible. "},{"ty":"ae","et":"positioned","id":"z.251663360.i.5","epm":{"pe_lo":3.095905511811024,"pe_l":4,"ee_eo":{"eo_bo":{"ln_s":0,"ln_w":0.0,"ln_c2":{"hclr_color":"#000000","clr_type":0}},"i_pid":null,"eo_mb":0.0,"i_ht":163.99228346456692,"eo_rtdf":{"rdf_ft":0},"eo_ml":9.0,"eo_mr":9.0,"eo_ad":"E:\\PALLAVI\\Museum Collection\\South Indian Bronze Gallery\\sjm_hyd-CS-I-1-225-4208_01_h.jpg","i_cid":"s-blob-v1-IMAGE-Dvix-4SrqPQ","i_cont":0.0,"eo_mt":0.0,"eo_type":0,"eo_lco":{"lc_oi":"","lc_cs":"","lc_ct":0,"lc_sci":"","lc_srk":""},"i_wth":93.45228346456693,"eo_at":null,"i_iwc":{"iwc_w":false},"eo_hb":false,"eo_rtd":"","i_crop":{"crop_oxr":-0.0,"crop_oyr":-0.0,"crop_rot":0.0,"crop_hr":1.0,"crop_wr":1.0},"i_iw":false,"i_rot":0.0,"i_clst":{"cv":{"op":"set","opValue":[]}},"i_bri":0.0,"i_msct":0,"i_src":null,"i_opa":1.0},"pe_to":3.5118897637795277}},{"ty":"ae","et":"positioned","id":"z.251664384.i.6","epm":{"pe_lo":-14.9,"pe_l":4,"ee_eo":{"eo_bo":{"ln_s":0,"ln_w":0.0,"ln_c2":{"hclr_color":"#000000","clr_type":0}},"i_pid":null,"eo_mb":0.0,"i_ht":148.6,"eo_rtdf":{"rdf_ft":0},"eo_ml":9.0,"eo_mr":9.0,"eo_ad":"E:\\PALLAVI\\Museum Collection\\South Indian Bronze Gallery\\sjm_hyd-XLII-184-39493_01_h.jpg","i_cid":"s-blob-v1-IMAGE-boaAIr0W0w4","i_cont":0.0,"eo_mt":0.0,"eo_type":0,"eo_lco":{"lc_oi":"","lc_cs":"","lc_ct":0,"lc_sci":"","lc_srk":""},"i_wth":140.7,"eo_at":null,"i_iwc":{"iwc_w":false},"eo_hb":false,"eo_rtd":"","i_crop":{"crop_oxr":-0.0,"crop_oyr":-0.0,"crop_rot":0.0,"crop_hr":1.0,"crop_wr":1.0},"i_iw":false,"i_rot":0.0,"i_clst":{"cv":{"op":"set","opValue":[]}},"i_bri":0.0,"i_msct":0,"i_src":null,"i_opa":1.0},"pe_to":4.0}},{"ty":"ae","et":"positioned","id":"z.251665408.i.7","epm":{"pe_lo":4.247952755905512,"pe_l":4,"ee_eo":{"eo_bo":{"ln_s":0,"ln_w":0.0,"ln_c2":{"hclr_color":"#000000","clr_type":0}},"i_pid":null,"eo_mb":0.0,"i_ht":184.8959842519685,"eo_rtdf":{"rdf_ft":0},"eo_ml":9.0,"eo_mr":9.0,"eo_ad":"E:\\PALLAVI\\Museum Collection\\South Indian Bronze Gallery\\sjm_hyd-XLII-233-39548_01_h.jpg","i_cid":"s-blob-v1-IMAGE-hw8vvfh_4qw","i_cont":0.0,"eo_mt":0.0,"eo_typ