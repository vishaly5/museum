<script>

const selector = document.getElementById('languageSelector');
const audioPlayer = document.getElementById('languageAudio');

const audioMap = {
  "bengali": "../audios/Bengali/2.%20MARBLE%20GALLERY/8.%20Bust%20of%20a%20young%20lady%20(XLV%20-%20166)_.wav",
  "hindi": "../audios/Hindi/02.%20Audio-MARBLE%20GALLERY/8.%20%E0%A4%8F%E0%A4%95%20%E0%A4%AF%E0%A5%81%E0%A4%B5%E0%A4%A4%E0%A5%80%20%E0%A4%95%E0%A5%80%20%E0%A4%85%E0%A4%B0%E0%A5%8D%E0%A4%A7%E0%A4%AA%E0%A5%8D%E0%A4%B0%E0%A4%A4%E0%A4%BF%E0%A4%AE%E0%A4%BE.wav",
  "kannada": "../audios/Kannada/2.MARBLE%20GALLERY/Bust%20of%20a%20young%20lady%20(XLV%20-%20166).wav",
  "malayalam": "../audios/Malyalam/Marble%20Gallery/Bust%20of%20a%20young%20lady.wav",
  "odia": "../audios/Odia/2.%20MARBLE%20GALLERY.or/8.%20Bust%20of%20a%20young%20lady%20(XLV%20-%20166).wav",
  "tamil": "../audios/Tamil/Marble%20Gallery.ta/8.%20Bust%20of%20a%20young%20lady%20_%20TA.wav"
};

function changeLanguage(language) {

    document.querySelectorAll('.langCnt').forEach(function(el) {
        el.style.display =
            el.id === language ? 'block' : 'none';
    });

    const audioSrc = audioMap[language];

    if (audioPlayer && audioSrc) {
        audioPlayer.pause();
        audioPlayer.currentTime = 0;
        audioPlayer.src = audioSrc;
        audioPlayer.load();
    }
}

selector.addEventListener('change', function() {
    changeLanguage(this.value);
});

changeLanguage(selector.value);

</script>

